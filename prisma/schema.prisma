// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. USER & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  company       String?
  jobTitle      String?
  country       String?
  status        String    @default("active") // active, suspended, deactivated
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth Relations
  accounts Account[]
  sessions Session[]

  // Organization Relations
  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]
  activityLogs        ActivityLog[]

  // Project Relations
  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]

  // Content Relations (Authoring)
  contentEntries ContentEntry[]

  // Workflow Approvals (User melakukan approve/reject)
  workflowLogs ContentWorkflowLog[]

  // Billing Relations
  subscriptions Subscription[]
  invoices      Invoice[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================================================
// 2. PLANS & BILLING
// ============================================================================

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
}

model Plan {
  id          String   @id @default(cuid())
  name        String // "Free", "Starter", "Professional", "Enterprise"
  tier        PlanTier @unique
  description String?
  price       Int // Price in cents (0 for free)

  // Feature Limits (null = unlimited)
  maxPersonalProjects         Int?
  maxOrganizations            Int?
  maxOrgProjects              Int?
  maxTeamMembersPerOrg        Int?
  maxContentEntriesPerProject Int?
  maxCustomDomains            Int?
  maxApiCallsPerMonth         Int?
  maxMediaStorageMB           Int?
  maxContentTypesPerProject   Int?
  maxLocalizations            Int?
  auditLogRetentionDays       Int  @default(7)

  // Features
  hasCustomDomains Boolean @default(false)
  hasLocalization  Boolean @default(false)
  hasWhiteLabel    Boolean @default(false)
  supportLevel     String  @default("community") // community, email, priority, dedicated

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id     String             @id @default(cuid())
  userId String
  planId String
  status SubscriptionStatus @default(TRIALING)

  // Billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Lifecycle
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  trialStart         DateTime?
  trialEnd           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  Plan    @relation(fields: [planId], references: [id])
  usage Usage[]

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model Usage {
  id             String @id @default(cuid())
  subscriptionId String

  // Usage Metrics
  personalProjectsCount Int @default(0)
  organizationsCount    Int @default(0)
  orgProjectsCount      Int @default(0)
  apiCallsMonth         Int @default(0)
  mediaStorageUsedMB    Int @default(0)

  // Period tracking
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([periodStart, periodEnd])
}

model Invoice {
  id             String  @id @default(cuid())
  userId         String
  subscriptionId String?

  amount   Int // Amount in cents
  currency String @default("USD")
  status   String // paid, pending, failed

  stripeInvoiceId String? @unique
  invoiceNumber   String?
  invoiceUrl      String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ============================================================================
// 3. ORGANIZATION & PROJECT
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  shortId     String   @unique // 6 karakter unik untuk display
  name        String
  slug        String   @unique
  description String?
  image       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner    User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  OrganizationMember[]
  projects Project[]

  @@index([ownerId])
  @@index([slug])
  @@index([shortId])
}

model OrganizationMember {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           String    @default("collaborator") // super-admin, collaborator
  status         String    @default("pending") // active, pending
  invitedAt      DateTime  @default(now())
  joinedAt       DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Project {
  id           String  @id @default(cuid())
  shortId      String  @unique // 6 karakter unik untuk display
  name         String
  slug         String
  description  String?
  status       String  @default("progress") // progress, completed, archived
  customDomain String?

  // Ownership
  ownerId        String
  organizationId String? // null = Personal Project

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]

  // CMS Features
  builderContentTypes BuilderContentType[]
  apiTokens           ApiToken[]
  workflows           Workflow[]
  roles               Role[] // Custom roles defined within this project
  ActivityLog         ActivityLog[]

  @@unique([organizationId, slug])
  @@index([ownerId])
  @@index([organizationId])
  @@index([shortId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleId    String
  status    String   @default("active") // active, pending
  addedAt   DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

// ============================================================================
// 4. ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String  @id @default(cuid())
  name        String // Super Admin, Admin, Editor, etc
  slug        String
  description String?
  color       String?
  isSystem    Boolean @default(false)

  projectId String? // null = global system role, filled = project specific role
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  permissions RolePermission[]
  members     ProjectMember[]

  // Role ini bisa ditugaskan di langkah workflow
  assignedWorkflowSteps WorkflowStep[]

  @@unique([slug, projectId])
  @@index([projectId])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  module    String // content, media, seo, settings, etc
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
}

// ============================================================================
// 5. API INTEGRATION (NEW FEATURE)
// ============================================================================
enum ApiTokenRole {
  full_access
  read_only
}

model ApiToken {
  id          String  @id @default(cuid())
  name        String
  description String?
  token       String  @unique // Hashed or plain token (e.g., "wf_sk_...")
  role        ApiTokenRole

  // Permissions stored as JSON (e.g. ["read", "create", "delete"])
  permissions Json   @default("[]")
  scope       String @default("Custom") // "Full Access", "Read Only", "Custom"

  expiresAt  DateTime? // Jika null = Forever
  lastUsedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ============================================================================
// 6. WORKFLOW APPROVAL (NEW FEATURE)
// ============================================================================

model Workflow {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Steps/Tahapan (e.g. Draft -> Editor Review -> Legal Review -> Publish)
  steps WorkflowStep[]

  // Tipe Konten yang menggunakan workflow ini
  appliedContentTypes BuilderContentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model WorkflowStep {
  id    String @id @default(cuid())
  name  String // e.g. "Editor Review"
  order Int // Urutan: 1, 2, 3

  // Siapa yang boleh approve di tahap ini? (Berdasarkan Role)
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Relasi ke konten yang sedang "stuck" di step ini
  currentContents ContentEntry[]

  @@index([workflowId])
  @@index([roleId])
}

// ============================================================================
// 7. CONTENT BUILDER (STRUCTURE SCHEMA)
// ============================================================================

model BuilderContentType {
  id          String  @id @default(cuid())
  name        String
  slug        String
  type        String // "SINGLE", "COLLECTION", "COMPONENT"
  description String?

  hasSeo       Boolean @default(false)
  hasMultiLang Boolean @default(false)

  // Link ke Workflow (Opsional)
  hasWorkflow Boolean   @default(false)
  workflowId  String?
  workflow    Workflow? @relation(fields: [workflowId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Pengelompokan field
  fieldGroups BuilderFieldGroup[]

  // Relasi ke Data Konten (Isi)
  contentEntries ContentEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Many-to-Many: Page uses multiple Components, Component used in multiple Pages
  usedComponents BuilderContentType[] @relation("PageComponents")
  usedInPages    BuilderContentType[] @relation("PageComponents")

  sectionsOrder Json? // Stores the order of interleaved FieldGroups and Components

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([workflowId])
}

model BuilderFieldGroup {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  contentTypeId String
  contentType   BuilderContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  fields BuilderField[]

  @@index([contentTypeId])
}

model BuilderField {
  id    String @id @default(cuid())
  name  String // Label: "Hero Title"
  apiId String // API Key: "hero_title"
  type  String // text, media, relation, etc

  // Validasi
  isRequired Boolean @default(false)
  isUnique   Boolean @default(false)

  // Relasi ke Group
  fieldGroupId String
  fieldGroup   BuilderFieldGroup @relation(fields: [fieldGroupId], references: [id], onDelete: Cascade)

  // Config tambahan (disimpan sebagai JSON)
  options Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldGroupId])
}

// ============================================================================
// 8. CONTENT ENTRY (DATA STORAGE)
// ============================================================================

model ContentEntry {
  id String @id @default(cuid())

  // Data utama disimpan sebagai JSON dinamis
  data Json @default("{}")

  // Data SEO terpisah
  seoData Json? @default("{}")

  // Status Publikasi
  status String @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED, REJECTED

  // WORKFLOW STATE (Posisi konten saat ini ada di step mana)
  currentStepId String?
  currentStep   WorkflowStep? @relation(fields: [currentStepId], references: [id])

  // Relasi ke Struktur Builder
  contentTypeId String
  contentType   BuilderContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  // Relasi ke Penulis (User)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Riwayat Approval/Log
  workflowLogs ContentWorkflowLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentTypeId])
  @@index([createdById])
  @@index([currentStepId])
}

// Log History (Siapa approve, kapan, komentar apa)
model ContentWorkflowLog {
  id String @id @default(cuid())

  contentEntryId String
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)

  actorId String // User yang melakukan aksi
  actor   User   @relation(fields: [actorId], references: [id])

  action   String // "SUBMIT", "APPROVE", "REJECT", "PUBLISH"
  stepName String? // Nama step saat aksi dilakukan (snapshot)
  comment  String? // Alasan reject/approve

  createdAt DateTime @default(now())

  @@index([contentEntryId])
  @@index([actorId])
}

model ActivityLog {
  id String @id @default(cuid())

  // Relasi ke User (Siapa yang melakukan aksi)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Detail Aksi
  action     String // Contoh: "CREATE_WORKFLOW"
  entityType String // Contoh: "Workflow", "ApiToken"
  entityId   String? // ID dari objek yang diubah
  entityName String? // Nama objek (untuk display log)

  // Metadata tambahan
  details   Json? // Simpan info detail lain dalam JSON
  ipAddress String?
  userAgent String?

  // Relasi ke Project
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}
