// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  company       String?
  jobTitle      String?
  country       String?
  status        String    @default("active") // active, suspended, deactivated
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth Relations
  accounts Account[]
  sessions Session[]

  // Organization Relations
  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]

  // Project Relations
  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]

  // Content Relations
  contentEntries ContentEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================================================
// ORGANIZATION
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  shortId     String   @unique // 6 karakter unik untuk display (e.g., "A1B2C3")
  name        String
  slug        String   @unique
  description String?
  image       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner    User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  OrganizationMember[]
  projects Project[]

  @@index([ownerId])
  @@index([slug])
  @@index([shortId])
}

model OrganizationMember {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           String    @default("collaborator") // owner, collaborator
  status         String    @default("pending") // active, pending
  invitedAt      DateTime  @default(now())
  joinedAt       DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ============================================================================
// PROJECT
// ============================================================================

model Project {
  id           String  @id @default(cuid())
  shortId      String  @unique // 6 karakter unik untuk display (e.g., "A1B2C3")
  name         String
  slug         String
  description  String?
  status       String  @default("progress") // progress, completed, archived
  customDomain String?

  // Ownership
  ownerId        String
  organizationId String? // null = Personal Project, ada = Organizational Project

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner               User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members             ProjectMember[]
  contentTypes        ContentType[]
  builderContentTypes BuilderContentType[]
  apiTokens            ApiToken[]

  @@unique([organizationId, slug])
  @@index([ownerId])
  @@index([organizationId])
  @@index([shortId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleId    String
  status    String   @default("active") // active, pending
  addedAt   DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

// ============================================================================
// ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String // Super Admin, Admin, Editor, SEO Manager, Viewer
  slug        String // super-admin, admin, editor, seo-manager, viewer
  description String?
  color       String? // Untuk badge color (blue, yellow, green, dll)
  isSystem    Boolean  @default(false) // true = role bawaan, tidak bisa dihapus
  projectId   String? // null = global role, ada = custom role per project
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  permissions RolePermission[]
  members     ProjectMember[]

  @@unique([slug, projectId])
  @@index([projectId])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  module    String // content, media, seo, settings, users, projects
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
}

// ============================================================================
// CONTENT MANAGEMENT
// ============================================================================

// Content Type (Blog, Product, Landing Page, dll)
model ContentType {
  id           String   @id @default(cuid())
  projectId    String
  name         String // "Blog Post", "Product", "Home Page"
  slug         String // "blog-post", "product", "home-page"
  description  String?
  type         String   @default("multiple") // single, multiple
  hasSeo       Boolean  @default(false)
  hasWorkflow  Boolean  @default(false)
  hasMultiLang Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldGroups FieldGroup[]
  entries     ContentEntry[]

  @@unique([projectId, slug])
  @@index([projectId])
}

// Field Group (untuk mengelompokkan fields)
model FieldGroup {
  id            String   @id @default(cuid())
  contentTypeId String
  name          String // "Hero Section", "SEO Settings"
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  fields      Field[]

  @@index([contentTypeId])
}

// Field Definition
model Field {
  id           String  @id @default(cuid())
  fieldGroupId String
  name         String // "Title", "Hero Image"
  slug         String // "title", "hero-image"
  type         String // text, richtext, number, date, image, boolean, relation, select
  description  String?
  placeholder  String?
  defaultValue String?
  order        Int     @default(0)

  // Validation
  isRequired Boolean @default(false)
  isUnique   Boolean @default(false)
  minLength  Int?
  maxLength  Int?
  min        Float?
  max        Float?

  // Options (untuk select, multiselect)
  options Json? // ["Option 1", "Option 2"] atau [{value, label}]

  // Relation Config (jika type = "relation")
  relationType  String? // one-to-one, one-to-many, many-to-many
  relatedTypeId String? // ID ContentType yang direlasikan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fieldGroup FieldGroup   @relation(fields: [fieldGroupId], references: [id], onDelete: Cascade)
  values     FieldValue[]

  @@unique([fieldGroupId, slug])
  @@index([fieldGroupId])
}

// Content Entry (Instance dari Content Type)
model ContentEntry {
  id            String    @id @default(cuid())
  contentTypeId String
  status        String    @default("draft") // draft, pending, approved, published
  locale        String    @default("en") // untuk multi-language
  createdById   String
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  seoSlug        String?

  // Relations
  contentType   ContentType       @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdById], references: [id])
  fieldValues   FieldValue[]
  relationsFrom ContentRelation[] @relation("FromEntry")
  relationsTo   ContentRelation[] @relation("ToEntry")

  @@index([contentTypeId])
  @@index([createdById])
  @@index([status])
}

// Field Values (Data aktual per entry)
model FieldValue {
  id      String  @id @default(cuid())
  entryId String
  fieldId String
  value   String? // JSON string untuk semua tipe data
  locale  String  @default("en")

  // Relations
  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  field Field        @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([entryId, fieldId, locale])
  @@index([entryId])
  @@index([fieldId])
}

// Content Relations (untuk relation fields)
model ContentRelation {
  id          String @id @default(cuid())
  fromEntryId String
  toEntryId   String
  fieldId     String
  order       Int    @default(0)

  // Relations
  fromEntry ContentEntry @relation("FromEntry", fields: [fromEntryId], references: [id], onDelete: Cascade)
  toEntry   ContentEntry @relation("ToEntry", fields: [toEntryId], references: [id], onDelete: Cascade)

  @@unique([fromEntryId, toEntryId, fieldId])
  @@index([fromEntryId])
  @@index([toEntryId])
}

model BuilderContentType {
  id          String  @id @default(cuid())
  name        String // Contoh: "Home", "Blog Post", "SEO Card"
  slug        String // Contoh: "home", "blog-post"
  type        String // "SINGLE", "COLLECTION", "COMPONENT"
  description String?

  hasSeo       Boolean  @default(false)
  hasWorkflow  Boolean  @default(false)
  hasMultiLang Boolean  @default(false)

  projectId String
  // Pastikan Anda menambahkan relasi "builderContentTypes BuilderContentType[]" di model Project nanti
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Pengelompokan field (agar bisa bikin Group seperti di desain)
  fieldGroups BuilderFieldGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}

// 2. Field Group: Pengelompokan field (misal: "Header Section", "SEO Settings")
model BuilderFieldGroup {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  contentTypeId String
  contentType   BuilderContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  fields BuilderField[]

  @@index([contentTypeId])
}

// 3. Field: Definisi inputan (Text, Media, Relation, dll)
// Ini menggantikan model "PageField" yang lama
model BuilderField {
  id    String @id @default(cuid())
  name  String // Label: "Hero Title"
  apiId String // ID untuk API: "hero_title"
  type  String // text, media, number, date, location, relation

  // Validasi (Sesuai dokumen requirements Anda)
  isRequired Boolean @default(false)
  isUnique   Boolean @default(false)

  // Relasi ke Group
  fieldGroupId String
  fieldGroup   BuilderFieldGroup @relation(fields: [fieldGroupId], references: [id], onDelete: Cascade)

  // Config tambahan (disimpan sebagai JSON agar fleksibel untuk masa depan)
  // Contoh: { "maxLength": 100, "relationTo": "blog_post_id" }
  options Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldGroupId])
}
model ApiToken {
  id          String    @id @default(cuid())
  name        String    // Contoh: "Website Frontend Token"
  description String?
  token       String    @unique // Kunci rahasia (misal: cm_12345xyz...)
  
  // Hak Akses
  role        String    @default("public") // public, read_write, full_access
  permissions Json?     // Opsional: Jika ingin custom permission
  
  // Validitas
  expiresAt   DateTime? // null = Never expires
  lastUsedAt  DateTime?
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}